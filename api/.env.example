PORT=3001
JWT_SECRET=change-this-to-a-random-secret-in-production
CLIENT_URL=http://localhost:5173

# SMTP for magic link emails (optional — without these the link is printed to the console in demo mode)
# Works with any SMTP provider: Gmail, SendGrid, Mailgun, AWS SES, Resend, etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@seattlesocial.com

# Stripe (optional — app works without these, uses demo mode)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
